{
  "themes": [
    {
      "name": "default"
    }
  ],
  "containers": [
    {
      "name": "game-menu",
      "visible": false,
      "components": [
        {
          "name":  "main-menu",
          "type": "menu",
          "items": [
            {
              "label": "Options",
              "action": "submenu",
              "type": "submenu",
              "items": [
                {
                  "label": "Rounds",
                  "command": "setMaxScore",
                  "context": "ui",
                  "type": "slider",
                  "minimum": 1,
                  "maximum": 21
                },
                {
                  "label": "Player 1 Up",
                  "command": "setLeftPaddleUpKey",
                  "context": "ui",
                  "type": "key_input",
                  "binds": "pong::leftPaddleUp"
                },
                {
                  "label": "Player 1 Down",
                  "command": "setLeftPaddleDownKey",
                  "context": "ui",
                  "type": "key_input",
                  "binds": "pong::leftPaddleDown"
                },
                {
                  "label": "Player 2 Up",
                  "command": "setRightPaddleUpKey",
                  "context": "ui",
                  "type": "key_input",
                  "binds": "pong::rightPaddleUp"
                },
                {
                  "label": "Player 2 Down",
                  "command": "setRightPaddleDownKey",
                  "context": "ui",
                  "type": "key_input",
                  "binds": "pong::rightPaddleDown"
                }
              ]
            },
            {
              "label": "Singleplayer",
              "command": "setSingleplayerMode",
              "context": "ui",
              "type": "action"
            },
            {
              "label": "Co-op",
              "command": "setCoopMode",
              "context": "ui",
              "type": "action"
            },
            {
              "label": "Quit",
              "command": "quit",
              "context": "ui",
              "type": "action"
            }
          ]
        }
      ]
    }
  ]
}
