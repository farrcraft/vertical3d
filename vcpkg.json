{
  "dependencies": [
    "boost-filesystem",
    "boost-foreach",
    "boost-headers",
    "boost-json",
    "boost-lexical-cast",
    "boost-optional",
    "boost-program-options",
    "boost-smart-ptr",
    "boost-system",
    "boost-test",
    "boost-unordered",
    "cgltf",
    "entt",
    "freetype",
    "glm",
    "libjpeg-turbo",
    "libpng",
    "spdlog",
    "sqlite3"
  ],
  "default-features": [
    "platform",
    "usd"
  ],
  "features": {
    "platform": {
      "description": "The window, the device and the audio: what the realtime renderer, the engine, input, the ui and audio need",
      "dependencies": [
        {
          "name": "sdl3",
          "features": [
            "vulkan"
          ]
        },
        "sdl3-mixer",
        "vulkan",
        "vulkan-memory-allocator"
      ]
    },
    "usd": {
      "description": "OpenUSD without its imaging, which the USD reader in interchange_usd reads a stage through",
      "dependencies": [
        {
          "name": "usd",
          "default-features": false
        }
      ]
    }
  }
}
