##RenderMan RIB-Structure 1.1
##Scene A grey floor and sphere under a rect, a disk, a sphere and a cylinder light, one over each quarter
version 3.03
Format 64 64 1
PixelSamples 8 8
Projection "perspective" "fov" [40]
Clipping 0.01 100
Translate 0 0 5
Rotate -30 1 0 0
WorldBegin
# each light faces its +z, turned to face down onto the floor. A light is placed in a
# transformation block, since an attribute block would turn it off at its end
TransformBegin
Translate -0.8 0 -0.8
Rotate 90 1 0 0
Scale 0.6 0.6 0.6
Light "PxrRectLight" "rect" "float intensity" [24]
TransformEnd
TransformBegin
Translate 0.8 0 -0.8
Rotate 90 1 0 0
Scale 0.6 0.6 0.6
Light "PxrDiskLight" "disk" "float intensity" [24] "color lightColor" [1 0.6 0.3]
TransformEnd
TransformBegin
Translate -0.8 0 0.8
Scale 0.3 0.3 0.3
Light "PxrSphereLight" "sphere" "float intensity" [24] "color lightColor" [0.3 0.6 1]
TransformEnd
TransformBegin
Translate 0.8 0 0.8
Scale 0.8 0.2 0.2
Light "PxrCylinderLight" "cylinder" "float intensity" [24] "color lightColor" [0.4 1 0.4]
TransformEnd
Color [0.6 0.6 0.6]
Surface "matte"
Polygon "P" [-2 -1 -2  2 -1 -2  2 -1 2  -2 -1 2]
AttributeBegin
Translate 0 -0.6 0
Sphere 0.4 -0.4 0.4 360
AttributeEnd
WorldEnd
