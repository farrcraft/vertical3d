##RenderMan RIB-Structure 1.1
##Scene A marble ball and a thin marble slab beside it, scattering below their surfaces, under a distant light, a light behind them and a dim dome
version 3.03
Format 96 64 1
PixelSamples 6 6
Projection "perspective" "fov" [40]
Clipping 0.01 100
Translate 0 0 5
Rotate -15 1 0 0
WorldBegin
Light "PxrDomeLight" "sky" "float intensity" [0.15]
LightSource "distantlight" 1 "intensity" [1.5] "from" [0 0 0] "to" [0.5 -0.8 0.6]
# a rect light shines along +z unless turned, so the one behind is turned to face the camera
TransformBegin
Translate 0 0.6 2.5
Rotate 180 0 1 0
Light "PxrRectLight" "behind" "float intensity" [6] "float exposure" [0]
TransformEnd
AttributeBegin
Bxdf "ND_open_pbr_surface_surfaceshader" "floor" "color base_color" [0.4 0.4 0.4] "float specular_roughness" [0.6]
Polygon "P" [-4 -1 -3  4 -1 -3  4 -1 3  -4 -1 3]
AttributeEnd
AttributeBegin
Bxdf "ND_open_pbr_surface_surfaceshader" "marble" "float subsurface_weight" [1] "color subsurface_color" [0.9 0.88 0.84]
     "float subsurface_radius" [0.3] "color subsurface_radius_scale" [1 0.9 0.8] "float specular_roughness" [0.15]
AttributeBegin
Translate -0.7 -0.25 0
Sphere 0.75 -0.75 0.75 360
AttributeEnd
# a ball squashed to a tenth of its depth lets the light behind it through
AttributeBegin
Translate 0.9 -0.2 0.2
Scale 0.6 0.8 0.08
Sphere 1 -1 1 360
AttributeEnd
AttributeEnd
WorldEnd
