<?xml version="1.0"?>
<materialx version="1.39">
  <nodegraph name="pattern">
    <constant name="tint" type="color3">
      <input name="value" type="color3" value="0.2, 0.4, 0.6" />
    </constant>
    <output name="colour" type="color3" nodename="tint" />
  </nodegraph>
  <open_pbr_surface name="shading" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="pattern" output="colour" />
    <input name="specular_roughness" type="float" value="0.1" />
  </open_pbr_surface>
  <surfacematerial name="painted" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="shading" />
  </surfacematerial>
</materialx>
