##RenderMan RIB-Structure 1.1
##Scene A quad sliding right and a quad turning, each across the whole shutter
version 3.03
Hider "raytrace"
Format 64 48 1
PixelSamples 4 4
Shutter 0 1
Projection "orthographic"
ScreenWindow -1.333333 1.333333 -1 1
Clipping 0.1 100
WorldBegin
Surface "constant"
AttributeBegin
# half a unit right while the shutter is open, which is twelve pixels
MotionBegin [0 1]
Translate 0 0 0
Translate 0.5 0 0
MotionEnd
Color [0.9 0.8 0.2]
Polygon "P" [-1.2 0.1 5  -0.4 0.1 5  -0.4 0.8 5  -1.2 0.8 5]
AttributeEnd
AttributeBegin
# a quarter turn about its own centre
Translate 0.6 -0.4 5
MotionBegin [0 1]
Rotate 0 0 0 1
Rotate 90 0 0 1
MotionEnd
Color [0.2 0.7 0.9]
Polygon "P" [-0.35 -0.15 0  0.35 -0.15 0  0.35 0.15 0  -0.35 0.15 0]
AttributeEnd
WorldEnd
