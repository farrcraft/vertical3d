##RenderMan RIB-Structure 1.1
##Scene A quad asymmetric about both axes, said in RIB
version 3.03
Format 64 48 1
# sixty-four samples a pixel under a one pixel box, so each pixel has a standard error
PixelSamples 8 8
PixelFilter "box" 1 1
Projection "orthographic"
# the defaults are RI_EPSILON and RI_INFINITY, which leave the orthographic depth scale at
# about 2e-38 and collapse every z onto the near plane
Clipping 1 100
WorldBegin
# the surface that emits its colour and scatters nothing, named rather than left as the
# default, so the picture is the colour alone
Surface "constant"
# asymmetric about both axes, so a flipped picture is a failing one. No Color, so it takes the
# RI default of white
Polygon "P" [-0.7 -0.2 5  0.3 -0.2 5  0.3 0.8 5  -0.7 0.8 5]
WorldEnd
