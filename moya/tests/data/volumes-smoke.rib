##RenderMan RIB-Structure 1.1
##Scene A puff of smoke Blender simulated, read from blender_smoke.vdb, on a grey floor under a distant light and a dim dome
version 3.03
Format 96 64 1
PixelSamples 6 6
Projection "perspective" "fov" [40]
Clipping 0.01 100
Translate 0 0 5
Rotate -15 1 0 0
WorldBegin
Light "PxrDomeLight" "sky" "float intensity" [0.2]
LightSource "distantlight" 1 "intensity" [2.5] "from" [0 0 0] "to" [0.6 -1 0.5]
AttributeBegin
Bxdf "ND_open_pbr_surface_surfaceshader" "floor" "color base_color" [0.5 0.5 0.5] "float specular_roughness" [0.6]
Polygon "P" [-4 -1 -3  4 -1 -3  4 -1 3  -4 -1 3]
AttributeEnd
# Blender's grid is z up and its puff stands over (0.97, 0.97), so it is turned y up and centred
AttributeBegin
Translate 0 -1 0
Scale 1.8 1.8 1.8
Rotate -90 1 0 0
Translate -0.97 -0.97 0
Pattern "ND_geompropvalue_float" "density" "string geomprop" ["density"]
Pattern "ND_multiply_vector3FA" "dark" "vector in1" [0.8 0.8 0.8] "reference float in2" ["density:out"]
Pattern "ND_multiply_vector3FA" "grey" "vector in1" [8 8 8] "reference float in2" ["density:out"]
Bxdf "ND_anisotropic_vdf" "smoke" "reference vector absorption" ["dark:out"] "reference vector scattering" ["grey:out"]
Volume "blobbydso:impl_openvdb" [0 2 0 2 0 2] [0 0 0] "constant string[2] blobbydso:stringargs" ["data/blender_smoke.vdb" "density:fogvolume"]
AttributeEnd
WorldEnd
