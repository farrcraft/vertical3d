##RenderMan RIB-Structure 1.1
##Scene A subdivision cube displaced by its material's fractal noise, on a grey floor under a rect light and a dim dome
version 3.03
Format 64 64 1
PixelSamples 8 8
Projection "perspective" "fov" [40]
Clipping 0.01 100
Translate 0 0 5
Rotate -20 1 0 0
WorldBegin
Light "PxrDomeLight" "sky" "float intensity" [0.25]
TransformBegin
Translate 0 1.5 -1
Rotate 70 1 0 0
Light "PxrRectLight" "rect" "float intensity" [6]
TransformEnd
AttributeBegin
Bxdf "ND_open_pbr_surface_surfaceshader" "floor" "color base_color" [0.5 0.5 0.5] "float specular_roughness" [0.6]
Polygon "P" [-2 -1 -2  2 -1 -2  2 -1 2  -2 -1 2]
AttributeEnd
AttributeBegin
Translate 0 -0.25 0
Rotate 30 0 1 0
Scale 1.2 1.2 1.2
Attribute "displacementbound" "float sphere" [0.3]
Bxdf "materialx" "rough" "string file" ["data/materials-patterns.mtlx"] "string material" ["rough"]
SubdivisionMesh "catmull-clark" [4 4 4 4 4 4] [0 1 3 2  2 3 7 6  6 7 5 4  4 5 1 0  1 5 7 3  4 0 2 6] [] [] [] []
    "P" [-0.5 -0.5 -0.5  0.5 -0.5 -0.5  -0.5 0.5 -0.5  0.5 0.5 -0.5  -0.5 -0.5 0.5  0.5 -0.5 0.5  -0.5 0.5 0.5  0.5 0.5 0.5]
AttributeEnd
WorldEnd
