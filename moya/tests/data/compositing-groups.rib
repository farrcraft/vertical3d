##RenderMan RIB-Structure 1.1
##Scene A plastic floor and wall and a grey sphere under a warm key light, a cool fill light and a dim dome, split into channels by light group
version 3.03
Format 48 32 1
PixelSamples 4 4
Projection "perspective" "fov" [40]
Clipping 0.01 100
Translate 0 0 5
Rotate -20 1 0 0
DisplayChannel "color key" "string source" ["color lpe:C.*<L.'key'>"]
DisplayChannel "color fill" "string source" ["color lpe:C.*<L.'fill'>"]
DisplayChannel "color rest" "string source" ["color lpe:C.*<L.[^'key''fill']>"]
Display "compositing-groups.exr" "openexr" "Ci,a,key,fill,rest"
WorldBegin
Light "PxrDomeLight" "sky" "float intensity" [0.2]
TransformBegin
Translate -0.9 0.6 -0.4
Scale 0.2 0.2 0.2
Light "PxrSphereLight" "warm" "float intensity" [60] "color lightColor" [1 0.7 0.4] "string lightGroup" ["key"]
TransformEnd
TransformBegin
Translate 0.9 0.6 -0.4
Scale 0.2 0.2 0.2
Light "PxrSphereLight" "cool" "float intensity" [30] "color lightColor" [0.4 0.6 1] "string lightGroup" ["fill"]
TransformEnd
Bxdf "ND_open_pbr_surface_surfaceshader" "floor" "color base_color" [0.6 0.6 0.6] "float specular_roughness" [0.4]
Polygon "P" [-2 -1 -2  2 -1 -2  2 -1 2  -2 -1 2]
Polygon "P" [-2 -1 2  2 -1 2  2 1.5 2  -2 1.5 2]
AttributeBegin
Translate 0 -0.6 0.2
Bxdf "ND_open_pbr_surface_surfaceshader" "grey" "color base_color" [0.5 0.5 0.5] "float specular_roughness" [0.3]
Sphere 0.4 -0.4 0.4 360
AttributeEnd
WorldEnd
