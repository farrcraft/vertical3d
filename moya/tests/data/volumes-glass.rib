##RenderMan RIB-Structure 1.1
##Scene A glass ball holding a ball of amber liquid, the liquid winning by its priority, before a wall showing blocks.png under a dome and a distant light
version 3.03
Format 96 64 1
PixelSamples 6 6
Projection "perspective" "fov" [40]
Clipping 0.01 100
Translate 0 0 5
Rotate -15 1 0 0
# the texture is a fixture beside this file
Option "searchpath" "texture" ["data:&"]
WorldBegin
Light "PxrDomeLight" "sky" "float intensity" [0.6]
LightSource "distantlight" 1 "intensity" [1.5] "from" [0 0 0] "to" [0.5 -1 0.7]
AttributeBegin
Bxdf "ND_open_pbr_surface_surfaceshader" "floor" "color base_color" [0.5 0.5 0.5] "float specular_roughness" [0.6]
Polygon "P" [-6 -1 -3  6 -1 -3  6 -1 5  -6 -1 5]
AttributeEnd
# the upper left corner is st (0, 0), which shows the image upright
AttributeBegin
Pattern "ND_image_color3" "blocks" "string file" ["blocks.png"]
Bxdf "ND_open_pbr_surface_surfaceshader" "wall" "reference color base_color" ["blocks:out"] "float specular_roughness" [0.6]
Polygon "P" [-4.5 -1 5  4.5 -1 5  4.5 4 5  -4.5 4 5]
        "st" [0 1  1 1  1 0  0 0]
AttributeEnd
AttributeBegin
Translate 0 -0.15 0
Attribute "identifier" "name" "glass"
Bxdf "ND_open_pbr_surface_surfaceshader" "glass" "float transmission_weight" [1] "float specular_ior" [1.5] "float specular_roughness" [0]
Sphere 0.85 -0.85 0.85 360
AttributeEnd
# the liquid lies inside the glass, and its higher priority makes the glass between them its wall
AttributeBegin
Translate 0 -0.15 0
Attribute "shade" "int intersectpriority" [1]
Attribute "identifier" "name" "liquid"
Bxdf "ND_open_pbr_surface_surfaceshader" "water" "float transmission_weight" [1] "float specular_ior" [1.33] "float specular_roughness" [0]
Bxdf "ND_anisotropic_vdf" "amber" "vector absorption" [0.1 0.4 1.0]
Sphere 0.72 -0.72 0.72 360
AttributeEnd
WorldEnd
