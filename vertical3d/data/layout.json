              { "editors": [{ "kind": "viewport", "camera": "Perspective" }] }
            ]
          }
        ]
      }
    },
    {
      "name": "Perspective",
      "root": { "editors": [{ "kind": "viewport", "camera": "Perspective" }] }
    }
  ]
