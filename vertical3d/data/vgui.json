                  "children": [
                    { "type": "button", "name": "answer0", "label": "", "context": "project", "command": "prompt::answer0" },
                    { "type": "button", "name": "answer1", "label": "", "context": "project", "command": "prompt::answer1" },
                    { "type": "button", "name": "answer2", "label": "", "context": "project", "command": "prompt::answer2" }
